# Copy to .env (git-ignored). docker compose and `just` read it automatically.
# The secrets file the Setup page (http://localhost:8700/setup) writes. Keep it OUTSIDE the repo.
SECRETS_FILE=/Users/you/twitch-party-overlay-secrets.env
# Log level: VERBOSE=1 is the "is it actually working" lines (one per real event). DEBUG=1 is everything.
VERBOSE=1
DEBUG=0
# Time zone for timestamps in the logs. Leave it out to use the machine's own zone; set an IANA name such as America/New_York to override it.
# TZ=
# For the downloaded program only (Docker never opens a browser): NO_OPEN=1 stops it opening the Dashboard on start.
# NO_OPEN=1
